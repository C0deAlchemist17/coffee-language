generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.db"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String
  name          String
  email         String?   @unique
  phone         String?
  role          String    @default("CASHIER")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  orders        Order[]
  attendance    Attendance[]
  cashDrawers   CashDrawer[]
  auditLogs     AuditLog[]
  shifts        Shift[]
}


model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  nameAr      String
  description String?
  color       String?
  icon        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  products    Product[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  nameAr        String
  barcode       String?     @unique
  description   String?
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  price         Float
  cost          Float
  stock         Int         @default(0)
  minStock      Int         @default(5)
  image         String?
  isActive      Boolean     @default(true)
  hasVariants   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  orderItems    OrderItem[]
  variants      ProductVariant[]
  inventory     Inventory[]
  stockMovements StockMovement[]
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  nameAr      String
  price       Float
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orderItems  OrderItem[]
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String    @unique
  email       String?
  address     String?
  points      Int       @default(0)
  totalSpent  Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  orders      Order[]
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  phone       String
  email       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  purchases   Purchase[]
}

model Table {
  id          String    @id @default(cuid())
  number      Int       @unique
  name        String
  capacity    Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  orders      Order[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  tableId         String?
  table           Table?      @relation(fields: [tableId], references: [id])
  type            String      @default("DINE_IN")
  status          String      @default("PENDING")
  subtotal        Float
  tax             Float       @default(0)
  discount        Float       @default(0)
  total           Float
  paid            Float       @default(0)
  change          Float       @default(0)
  notes           String?
  isHold          Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  items           OrderItem[]
  payments        Payment[]
}


model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity        Int
  price           Float
  total           Float
  notes           String?
  status          String         @default("PENDING")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}


model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  method          String
  amount          Float
  reference       String?
  createdAt       DateTime      @default(now())
}


model Shift {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  openingBalance  Float
  closingBalance Float?
  openingTime     DateTime  @default(now())
  closingTime     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  cashDrawer      CashDrawer?
}

model CashDrawer {
  id              String    @id @default(cuid())
  shiftId         String?   @unique
  shift           Shift?    @relation(fields: [shiftId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  balance         Float     @default(0)
  isOpen          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Inventory {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Int
  unit            String
  location        String?
  minLevel        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model StockMovement {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  type            String
  quantity        Int
  notes           String?
  referenceId     String?
  createdAt       DateTime        @default(now())
}


model Purchase {
  id              String    @id @default(cuid())
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  total           Float
  paid            Float
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Expense {
  id              String    @id @default(cuid())
  category        String
  description     String
  amount          Float
  date            DateTime  @default(now())
  notes           String?
  createdAt       DateTime  @default(now())
}

model Attendance {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  checkIn         DateTime  @default(now())
  checkOut        DateTime?
  duration        Int?
  createdAt       DateTime  @default(now())
}

model AuditLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  action          String
  entity          String
  entityId        String?
  details         String?
  ipAddress       String?
  createdAt       DateTime  @default(now())
}

model Settings {
  id              String    @id @default(cuid())
  key             String    @unique
  value           String
  description     String?
  updatedAt       DateTime  @updatedAt
}

model Backup {
  id              String    @id @default(cuid())
  filename        String
  path            String
  size            Int
  createdAt       DateTime  @default(now())
}
